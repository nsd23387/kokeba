# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/kokeba
OBJECT_STORAGE_BUCKET=kokeba-assets

# ---- AI / Agents ----
ANTHROPIC_API_KEY=
IMAGE_GEN_API_KEY=

# ---- Integrations ----
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
KDP_RESEARCH_API_KEY=        # e.g. BookBeam / Publisher Rocket data source

# ---- Control Plane ----
ADS_DAILY_BUDGET_CAP_USD=20
ADS_MONTHLY_BUDGET_CAP_USD=400
APPROVAL_MODE=copilot        # copilot | autopilot
KILL_SWITCH=off              # off | on  (on = pause all agents/campaigns)

# ---- Licensing ----
KOKEBA_LICENSE_KEY=
ENABLED_TIERS=engine,studio  # engine,studio,marketing,...
