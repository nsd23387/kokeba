# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://user:pass@localhost:5432/kokeba
OBJECT_STORAGE_BUCKET=kokeba-assets

# ---- AI / Agents ----
ANTHROPIC_API_KEY=
IMAGE_GEN_API_KEY=            # OpenAI key with image-gen access (used by scripts/illustrate)
IMAGE_GEN_MODEL=gpt-image-1   # OpenAI image model id (e.g. gpt-image-1)
IMAGE_GEN_QUALITY=high        # low | medium | high | auto
IMAGE_GEN_SIZE=1024x1024      # 1024x1024 (square, 0-3) | 1024x1536 | 1536x1024

# ---- Integrations ----
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
KDP_RESEARCH_API_KEY=        # e.g. BookBeam / Publisher Rocket data source
DATAFORSEO_LOGIN=            # DataForSEO API login → live market validation (search volume + keyword difficulty)
DATAFORSEO_PASSWORD=         # DataForSEO API password
DATAFORSEO_LOCATION=United States   # market to measure demand/competition in

# ---- Control Plane ----
ADS_DAILY_BUDGET_CAP_USD=20
ADS_MONTHLY_BUDGET_CAP_USD=400
APPROVAL_MODE=copilot        # copilot | autopilot
KILL_SWITCH=off              # off | on  (on = pause all agents/campaigns)

# ---- Licensing ----
KOKEBA_LICENSE_KEY=
ENABLED_TIERS=engine,studio  # engine,studio,marketing,...
